    given-names: "Carlos Nicolás"
version: 0.1.0
date-released: 2026-11-16
license: MIT
repository-code: "https://github.com/NicoRojasDev/vigia"
keywords:
  - computer vision
  - driver drowsiness
  - PERCLOS
  - MediaPipe
  - OpenCV
  - privacy by design
